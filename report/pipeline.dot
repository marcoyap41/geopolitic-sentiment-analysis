digraph P {
  rankdir=TB; nodesep=0.5; ranksep=0.32; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#f4f6f8", color="#5b6770", fontname="Helvetica", fontsize=12, margin="0.18,0.10", width=6.4];
  edge [color="#5b6770", arrowsize=0.8];

  s1 [label=<<B>1. Data (hasil Tugas 1)</B><BR/>Berita CNBC: judul (41.406 artikel, terfilter geopolitik/makro)<BR/>Kurs JISDOR BI IDR/USD harian (1.201 hari target)>];
  s2 [label=<<B>2. Formulasi target dan split</B>  <I>(src/split.py)</I><BR/>y_T = 1 jika kurs_T &gt; kurs_(T-1), selain itu 0<BR/>Berita terbit tanggal d dipasangkan ke T = hari kerja pertama setelah d<BR/>Split kronologis 60/20/20: train 720 | val 240 | test 241 hari>];
  s3 [label=<<B>3. Preprocessing teks</B>  <I>(src/preprocessing.py)</I><BR/>Versi ringan (untuk lexicon) dan versi bersih: lowercase, stopword, lemmatize (untuk TF-IDF)>];
  s4 [label=<<B>4. Ekstraksi fitur</B>  <I>(src/features.py, src/dataset.py)</I><BR/>Lexicon per artikel: VADER + Loughran-McDonald  →  rata-rata harian<BR/>1 dokumen per hari → TF-IDF (1-2 gram) → SVD 50 dimensi<BR/>Fitur kurs: lag return 1-5, rata-rata dan std 5 hari>];
  s5 [label=<<B>5. Pemodelan</B>  <I>(src/baseline.py, src/model.py)</I><BR/>Baseline: majority, persistence (naive), ARIMA, XGBoost fitur kurs saja<BR/>Model gabungan: XGBoost pada kurs + NLP (lexicon, TF-IDF, atau keduanya)>];
  s6 [label=<<B>6. Evaluasi</B>  <I>(src/evaluate.py, src/run_experiments.py)</I><BR/>Model dilatih di train; hyperparameter dipilih dengan data validasi; test dipakai sekali<BR/>Metrik: Directional Accuracy dan F1 macro>];

  s1 -> s2 -> s3 -> s4 -> s5 -> s6;

  g1 [label="Guard anti-leakage:\nberita hanya dari tanggal < T", shape=box, style="rounded,filled", fillcolor="#fde9e7", color="#c0392b", fontsize=10.5, width=2.6];
  g2 [label="Guard anti-leakage:\nTF-IDF/SVD di-fit hanya di train;\nfitur kurs hanya data <= T-1", shape=box, style="rounded,filled", fillcolor="#fde9e7", color="#c0392b", fontsize=10.5, width=2.6];
  g3 [label="Guard anti-leakage:\ntest dipakai sekali;\nsplit tanpa shuffle", shape=box, style="rounded,filled", fillcolor="#fde9e7", color="#c0392b", fontsize=10.5, width=2.6];
  {rank=same; s2; g1} {rank=same; s4; g2} {rank=same; s6; g3}
  g1 -> s2 [dir=none, style=dashed, color="#c0392b"];
  g2 -> s4 [dir=none, style=dashed, color="#c0392b"];
  g3 -> s6 [dir=none, style=dashed, color="#c0392b"];
}
